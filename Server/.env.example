# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=ClacsListening
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=true

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://clacs:clacs@localhost:5432/clacslistening
DATABASE_URL_SYNC=postgresql+psycopg2://clacs:clacs@localhost:5432/clacslistening

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Anthropic (Claude) ───────────────────────────────────────────────────────
# Obteres em: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# ══════════════════════════════════════════════════════════════════════════════
# WHATSAPP BUSINESS API
# ══════════════════════════════════════════════════════════════════════════════
# Como obter:
#   1. https://developers.facebook.com → Criar App → Business
#   2. Adicionar produto WhatsApp
#   3. Em Configuração da API encontras Phone Number ID e token temporário
#   4. Para token permanente: Meta Business Manager → Utilizadores do Sistema
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=EAAxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Define tu mesmo — qualquer string secreta — usa ao registar o webhook
WHATSAPP_VERIFY_TOKEN=clacslistening-verify

# ══════════════════════════════════════════════════════════════════════════════
# FACEBOOK GRAPH API
# ══════════════════════════════════════════════════════════════════════════════
# Como obter:
#   1. https://developers.facebook.com → teu App → Graph API Explorer
#   2. Selecciona a tua Página → Gera Page Access Token
#   3. Estende o token para 60 dias (ou usa System User para token permanente)
#   4. FACEBOOK_PAGE_ID: vai à tua Página → Sobre → ID da Página
# Permissões necessárias: pages_read_engagement, pages_read_user_content
# Documentação: https://developers.facebook.com/docs/graph-api
FACEBOOK_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxx
FACEBOOK_PAGE_ID=123456789012345
FACEBOOK_APP_ID=987654321
FACEBOOK_APP_SECRET=abc123def456
# Token de verificação do webhook — define tu mesmo
FACEBOOK_WEBHOOK_VERIFY_TOKEN=clacslistening-fb-verify

# ══════════════════════════════════════════════════════════════════════════════
# INSTAGRAM GRAPH API
# ══════════════════════════════════════════════════════════════════════════════
# PRÉ-REQUISITO: conta Instagram Profissional ligada a uma Página Facebook
# Como obter o INSTAGRAM_BUSINESS_ACCOUNT_ID:
#   GET https://graph.facebook.com/v19.0/{FACEBOOK_PAGE_ID}?fields=instagram_business_account&access_token={token}
#   O id retornado é o teu INSTAGRAM_BUSINESS_ACCOUNT_ID
# O token é o mesmo do Facebook (Page Access Token)
# Documentação: https://developers.facebook.com/docs/instagram-api
INSTAGRAM_ACCESS_TOKEN=EAAxxxxxxxxxx
INSTAGRAM_BUSINESS_ACCOUNT_ID=17841400000000000

# ══════════════════════════════════════════════════════════════════════════════
# TIKTOK RESEARCH API
# ══════════════════════════════════════════════════════════════════════════════
# ATENÇÃO: requer aprovação (2-4 semanas)
# Como obter:
#   1. https://developers.tiktok.com/application/
#   2. Cria app tipo "Research" e submete candidatura
#   3. Após aprovação recebes CLIENT_KEY e CLIENT_SECRET
# Documentação: https://developers.tiktok.com/products/research-api/
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Alternativa ao TikTok Research API (sem aprovação, tem custo)
# Como obter: https://apify.com → Console → Account → Integrations → API Token
TIKTOK_USE_APIFY=false
APIFY_API_TOKEN=apify_api_...

# ─── Outras APIs ──────────────────────────────────────────────────────────────
# SocialFetch (fallback genérico): https://socialfetch.dev → Dashboard → API Keys
SOCIALFETCH_API_KEY=

# Google Places (reviews): https://console.cloud.google.com → APIs & Services → Credenciais
GOOGLE_PLACES_API_KEY=

# ─── Worker ───────────────────────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=15
BRAIN_INTERVAL_MINUTES=5
REPORT_HOUR_UTC=7
